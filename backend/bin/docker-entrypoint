#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ] && [ -f /usr/lib/*/libjemalloc.so.2 ]; then
  export LD_PRELOAD="$(echo /usr/lib/*/libjemalloc.so.2)"
fi

# If running the rails server then create or migrate existing database
if [ "${1}" == "./bin/rails" ] && [ "${2}" == "server" ]; then
  # Self-heal the gem bundle: in development the bind-mounted Gemfile.lock
  # can drift ahead of what's actually installed in the bundle_data volume
  # (e.g. after adding a gem), since that named volume persists across
  # rebuilds. `bundle check` is a fast no-op when everything matches.
  bundle check || bundle install
  ./bin/rails db:prepare
fi

exec "${@}"

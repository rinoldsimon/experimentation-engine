# Database Configuration
DB_HOST=localhost
DB_USERNAME=your_local_postgres_user
DB_PASSWORD=your_local_postgres_password

# Optional: used by VariantContentGenerator (app/services/variant_content_generator.rb)
# to generate LLM-written variant copy at experiment *configuration* time only --
# never on the visitor-facing assignment path (see DESIGN.md's "The LLM decision").
# Get a free key at https://aistudio.google.com/apikey. If unset, variants that
# request content_source: "llm" simply fall back to their supplied default text
# instead of failing -- this key is not required for the core service to work.
GEMINI_API_KEY=your_gemini_api_key

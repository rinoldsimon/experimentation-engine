# Committed on purpose (see .gitignore): not a secret, just a fixed value so
# `npm test` and CI work without any local setup. api.ts throws at import
# time if VITE_API_URL is unset, and all network calls in tests are mocked
# anyway, so the actual value here is never really used to reach a server.
VITE_API_URL=http://localhost:3000
